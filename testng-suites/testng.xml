<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Test Suite" parallel="methods" thread-count="4">
 <listeners>
        <listener class-name="com.saucedemo.reporter.TestListener"/>
        <listener class-name="com.saucedemo.reporter.AnnotationTransformer"/>
    </listeners>
    <test name="Parallel Tests">
        <classes>
            <class name="com.saucedemo.tests.LoginAuthenticationTests"/>
             <class name="com.saucedemo.tests.InventoryTests"/>
             <class name="com.saucedemo.tests.CartManagementTests"/>
             <class name="com.saucedemo.tests.CheckoutStepOneAndTwoTests"/>
             <class name="com.saucedemo.tests.CheckOutCompletionTests"/>
             
        </classes>
    </test>
</suite>
